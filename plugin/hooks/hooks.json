{
  "description": "Docket's shared hooks. Each hook's short name is its script's file name; a desk turns one off by that name (docketHooks.off in clients.local.json), and the script then exits without doing anything.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-cmdline-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking Bash command length"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell|search_replace|write|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shift-first-edit.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the Shift gear before a file edit or git commit"
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/artifact-new-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking that an artifact publish updates an existing page"
          }
        ]
      }
    ]
  }
}
